# Oyaya Flour Factory ERP — environment template
# Copy to .env and fill in secrets. Never commit .env.

# Database
DB_USER=oyaya
DB_PASSWORD=change_me
DB_NAME=oyaya_erp
DB_PORT=5432
DATABASE_URL=postgresql://oyaya:change_me@localhost:5432/oyaya_erp

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# API
API_PORT=8902
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Web
WEB_PORT=8903
NGINX_HTTP=80
NGINX_HTTPS=443
VITE_API_URL=http://localhost:8902/api/v1

# AfroMessage SMS gateway (https://www.afromessage.com)
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_ID=OYAYA_MILL
AFROMESSAGE_CALLBACK_URL=https://erp.oyayaflour.com/api/v1/webhooks/afromessage/status

# ZKTeco
ZK_POLL_INTERVAL_MIN=5
ZK_DEVICE_TIMEOUT_MS=5000

# Business defaults
STANDARD_SHIFT_HOURS=8
OVERTIME_RATE_MULTIPLIER=1.5
