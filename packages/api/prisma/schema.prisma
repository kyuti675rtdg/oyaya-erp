// Module 12 — Product Traceability (merged 2026-10-17)
// Plain-string foreign keys (no relation edits on existing models),
// matching the pattern used elsewhere in this schema.
enum RecallSeverity {
  CLASS_I
  CLASS_II
  CLASS_III
}

enum RecallCaseStatus {
  DRAFT
  OPEN
  INVESTIGATING
  DISPOSITIONED
  CLOSED
}

enum RecallDisposition {
  RELEASE
  REWORK
  REJECT
  DESTROY
}

enum RecallItemStatus {
  AFFECTED
  HELD
  RELEASED
  RECALLED
}

model RecallCase {
  id               String             @id @default(cuid())
  caseNo           String             @unique // REC-2026-0001
  rootType         String             // INTAKE | BATCH | LOT
  rootBatchId      String?
  rootBatchNo      String?
  rootLotNo        String?
  severity         RecallSeverity
  reason           String
  status           RecallCaseStatus   @default(OPEN)
  impactSnapshot   Json?              // affected downstream items at case creation
  investigationLog Json?              // [{ at, by, step }]
  disposition      RecallDisposition?
  dispositionNote  String?
  decidedById      String?
  decidedAt        DateTime?
  openedById       String?
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  items            RecallAffectedItem[]

  @@index([status])
  @@index([rootBatchNo])
}

model RecallAffectedItem {
  id           String           @id @default(cuid())
  caseId       String
  case         RecallCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  batchNo      String?
  lotNo        String?
  productName  String?
  quintals     Decimal?         @db.Decimal(12, 2)
  bags         Int?
  customerName String?
  status       RecallItemStatus @default(AFFECTED)
  note         String?
  createdAt    DateTime         @default(now())

  @@index([caseId])
  @@index([batchNo])
}

// ─── Sales & Distribution — Module 13 expansion (order lines, agreements,
// advances application, truck loads, delivery trips, agent stock, recon) ────

model SalesOrderLine {
  id              String         @id @default(cuid())
  orderId         String
  order           SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  packagingSizeId String?
  packagingSize   PackagingSize? @relation(fields: [packagingSizeId], references: [id])
  bags            Int            @default(0)
  quintals        Decimal        @db.Decimal(12, 2)
  priceBirr       Decimal        @db.Decimal(18, 2) // per-quintal price for this line
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
}

model SalesAgreement {
  id           String   @id @default(cuid())
  agreementNo  String   @unique
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  name         String
  validFrom    DateTime @db.Date
  validTo      DateTime @db.Date
  discountPct  Decimal  @db.Decimal(5, 2) @default(0)
  status       String   @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | SUSPENDED
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  lines        SalesAgreementLine[]

  @@index([customerId])
  @@index([status])
}

model SalesAgreementLine {
  id              String         @id @default(cuid())
  agreementId     String
  agreement       SalesAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  packagingSizeId String?
  packagingSize   PackagingSize? @relation(fields: [packagingSizeId], references: [id])
  priceBirr       Decimal        @db.Decimal(18, 2) // base price per quintal
  // Discount tiers: [{ minBags: number, discountPct: number, priceBirr: number }]
  tiers           Json?
}

model AdvanceApplication {
  id          String       @id @default(cuid())
  advanceId   String
  advance     AdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountBirr  Decimal      @db.Decimal(18, 2)
  appliedAt   DateTime     @default(now())
  appliedById String?

  @@index([advanceId])
  @@index([invoiceId])
}

model TruckLoad {
  id               String   @id @default(cuid())
  loadNo           String   @unique
  vehicleId        String?
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id])
  route            String   // destination route / area
  capacityQuintals Decimal  @db.Decimal(12, 2) @default(300)
  status           String   @default("BUILDING") // BUILDING | READY | LOADED | DISPATCHED | CANCELLED
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  items            TruckLoadItem[]

  @@index([status])
  @@index([vehicleId])
}

model TruckLoadItem {
  id        String    @id @default(cuid())
  loadId    String
  load      TruckLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id])
  bags      Int       @default(0)
  quintals  Decimal   @db.Decimal(12, 2)

  @@unique([loadId, orderId])
  @@index([loadId])
}

model DeliveryTrip {
  id             String    @id @default(cuid())
  tripNo         String    @unique
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  driverName     String?
  area           String    // route / destination area
  status         String    @default("PLANNED") // PLANNED | DEPARTED | ARRIVED | POD_CONFIRMED | CANCELLED
  departedAt     DateTime?
  arrivedAt      DateTime?
  podReceivedAt  DateTime?
  podSignedBy    String?
  dispatchId     String?
  dispatch       Dispatch? @relation(fields: [dispatchId], references: [id])
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([vehicleId])
  @@index([status])
}

model AgentStockPlacement {
  id              String         @id @default(cuid())
  placementNo     String         @unique
  customerId      String         // the sales agent
  customer        Customer       @relation(fields: [customerId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  packagingSizeId String?
  packagingSize   PackagingSize? @relation(fields: [packagingSizeId], references: [id])
  bags            Int            @default(0)
  quintals        Decimal        @db.Decimal(12, 2)
  unitPriceBirr   Decimal        @db.Decimal(18, 2) // per quintal consignment/settlement price
  status          String         @default("PLACED") // PLACED | PARTIALLY_SETTLED | SETTLED | RETURNED
  placedAt        DateTime       @default(now())
  settledAt       DateTime?
  notes           String?
  createdById     String?
  settlements     AgentStockSettlement[]

  @@index([customerId])
  @@index([status])
}

model AgentStockSettlement {
  id          String              @id @default(cuid())
  placementId String
  placement   AgentStockPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  bags        Int                 @default(0)
  quintals    Decimal             @db.Decimal(12, 2)
  amountBirr  Decimal             @db.Decimal(18, 2)
  settledAt   DateTime            @default(now())
  settledById String?
  notes       String?
}

model SalesInvoiceLine {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId         String?
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  packagingSizeId String?
  packagingSize   PackagingSize? @relation(fields: [packagingSizeId], references: [id])
  bags            Int            @default(0)
  quintals        Decimal        @db.Decimal(12, 2)
  unitPriceBirr   Decimal        @db.Decimal(18, 2)
  lineTotalBirr   Decimal        @db.Decimal(18, 2)
}

model CashReconciliation {
  id             String   @id @default(cuid())
  reconDate      DateTime @db.Date @unique
  expectedBirr   Decimal  @db.Decimal(18, 2)
  collectedBirr  Decimal  @db.Decimal(18, 2)
  varianceBirr   Decimal  @db.Decimal(18, 2)
  status         String   @default("BALANCED") // BALANCED | VARIANCE_OPEN | RESOLVED
  depositRef     String?
  depositedAt    DateTime?
  notes          String?
  reconciledById String?
  createdAt      DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════
// Module 19 — Support & Documentation Center (merged 2026-10-17)
// ═══════════════════════════════════════════════════════════════════

// Manuals & SOPs with version control
model SopDocument {
  id          String    @id @default(cuid())
  docNo       String    @unique
  docType     String    // 'MANUAL' | 'SOP'
  title       String
  module      String?   // ERP module key
  version     String    @default("1.0")
  status      String    @default("DRAFT") // DRAFT | UNDER_REVIEW | APPROVED | ARCHIVED
  effectiveDate DateTime? @db.Date
  reviewDate    DateTime? @db.Date
  summary     String?
  content     String    // markdown body / steps
  approverId  String?
  approvedAt  DateTime?
  supersedesId String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([docType, status])
  @@index([module])
}

// Knowledge base articles & FAQs
model KbArticle {
  id        String   @id @default(cuid())
  title     String
  category  String   // 'faq' | 'troubleshooting' | 'howto' | 'guide'
  tags      String[] @default([])
  content   String   // markdown
  faq       Boolean  @default(false)
  pinned    Boolean  @default(false)
  views     Int      @default(0)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// System announcements
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  targetRoles String[] @default([]) // empty = all roles
  urgent      Boolean  @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  authorId    String
  reads       AnnouncementRead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// Technical support session records
model TechSupportRecord {
  id           String    @id @default(cuid())
  recordNo     String    @unique
  title        String
  category     String    // 'network' | 'hardware' | 'software' | 'training' | 'other'
  description  String
  resolution   String?
  durationMins Int?
  technicianId String
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
}

// In-system notifications
model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("info") // info | warning | alert | success
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Document Management (Module 20)
// ═══════════════════════════════════════════════════════════════════

model DocFolder {
  id          String   @id @default(cuid())
  name        String
  parentId    String?
  module      String?  // ERP module key (Procurement, Production, HR, ...)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   DocFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children DocFolder[] @relation("FolderHierarchy")
  documents Document[]

  @@index([parentId])
  @@index([module])
}

model Document {
  id            String    @id @default(cuid())
  docNo         String    @unique
  title         String
  description   String?
  category      String    @default("General")
  tags          String[]  @default([])
  fileName      String
  mimeType      String    @default("application/octet-stream")
  fileSize      Int       @default(0)
  storagePath   String?
  folderId      String?
  status        String    @default("DRAFT") // DRAFT | UNDER_REVIEW | APPROVED | PUBLISHED | ARCHIVED
  version       String    @default("1.0")
  checkedOutById String?
  retentionUntil DateTime? @db.Date
  uploadedById  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  folder    DocFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions  DocVersion[]
  approvals DocApproval[]
  shares    DocShare[]
  chatAttachments ChatAttachment[]

  @@index([status])
  @@index([category])
  @@index([folderId])
  @@index([uploadedById])
}

model DocVersion {
  id         String   @id @default(cuid())
  documentId String
  version    String
  fileName   String
  fileSize   Int      @default(0)
  storagePath String?
  changeNote String?
  createdById String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model DocApproval {
  id         String    @id @default(cuid())
  documentId String
  approverId String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, status])
  @@index([approverId])
}

model DocTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("General")
  description String?
  content     String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model DocShare {
  id           String    @id @default(cuid())
  documentId   String
  sharedWithId String?   // user id; null = link share
  role         String?   // role name for role-based share
  permission   String    @default("VIEW") // VIEW | EDIT
  token        String?   @unique
  expiresAt    DateTime?
  accessCount  Int       @default(0)
  createdById  String
  createdAt    DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([token])
}





// ─── Native Team Chat (fully free, no external service) ───────────────

model ChatChannel {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("department") // department | dm | announcements | management | general
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members  ChatChannelMember[]
  messages ChatMessage[]

  @@index([type])
  @@index([departmentId])
}

model ChatChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // member | moderator | owner
  joinedAt  DateTime @default(now())
  lastReadAt DateTime?

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  attachments ChatAttachment[]

  @@index([channelId, createdAt])
  @@index([senderId])
}

model ChatAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String?  // auto-saved Document in DMS
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fileName  String
  mimeType  String   @default("application/octet-stream")
  fileSize  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([messageId])
}
