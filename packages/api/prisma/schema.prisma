// Oyaya Flour Factory ERP — Prisma schema (PostgreSQL 16)
// Covers all 17 SRS modules: master data, procurement, storage/conditioning,
// production/blending, QC, CAPA, hygiene, pest, maintenance, FG, warehouse,
// traceability, sales, Peachtree finance, tri-mode payroll, fleet, dashboards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & RBAC ──────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  address   String?
  taxId     String?
  logoUrl   String?
  // Module 18: company profile + org settings
  phone              String?
  email              String?
  fiscalYearStartMonth Int? // 1-12, calendar month the fiscal year starts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  isActive     Boolean   @default(true)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  employee     Employee?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
  reportedTickets SupportTicket[] @relation("TicketReporter")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketComments  TicketComment[]
  // Module 18: MFA (TOTP)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  // Native team chat
  chatChannelMemberships ChatChannelMember[]
  chatMessages ChatMessage[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. "Owner / CEO", "Quality / Lab Head"
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]
}

// Granular claim: module:action:scope, e.g. "procurement:intake:approve"
model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  module    String
  action    String
  scope     String           @default("all") // all | own | department
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── Master Data (Module 1) ──────────────────────────────────────

enum SupplierType {
  INDIVIDUAL_FARMER
  ASSOCIATION
  TRADER
}

enum WheatCategory {
  SOFT
  HARD
  FOREIGN
}

model Supplier {
  id             String       @id @default(cuid())
  name           String
  type           SupplierType
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  region         String?
  tin            String?
  licenseNo      String?
  wheatTypes     String[]     @default([])
  paymentTerms   String?
  bankName       String?
  bankAccountNo  String?
  rating         Int?         // 1-5 supplier score
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  intakes        WheatIntake[]
  purchaseOrders PurchaseOrder[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  prices    CustomerPrice[]
  orders    SalesOrder[]
  advances  AdvancePayment[]
  receipts  CashReceipt[]
  agreements SalesAgreement[]
  agentPlacements AgentStockPlacement[]
}

model CustomerPrice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  priceBirr  Decimal  @db.Decimal(18, 2)

  @@unique([customerId, productId])
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique // Duket (Normal), Duket (Special), Furishka, Fino, Fernacho
  kind        String   // flour | silage | feed
  uom         String   @default("quintal")
  isActive    Boolean  @default(true)
  prices      CustomerPrice[]
  shiftOutput ShiftOutput[]
  packRuns    PackagingRun[]
  dispatch    DispatchLine[]
  fgStock     FinishedGoodsStock[]
  grades       FlourGrade[]
  labelPrints  LabelPrint[]
  fgAdjustments FgStockAdjustment[]
  whLedger        WhStockLedger[]
  whPutAwayItems  WhPutAwayItem[]
  whTransferItems WhStockTransferItem[]
  whAdjustItems   WhAdjustmentItem[]
  whReservations  WhReservation[]
  whDispatchItems WhDispatchItem[]
  whCountLines    WhCountLine[]
  salesOrderLines SalesOrderLine[]
  agreementLines  SalesAgreementLine[]
  invoiceLines    SalesInvoiceLine[]
  agentPlacements AgentStockPlacement[]
}

model PackagingSize {
  id       String  @id @default(cuid())
  label    String  @unique // 50kg, 25kg, 10kg, 5kg
  kg       Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)
  salesOrderLines SalesOrderLine[]
  agreementLines  SalesAgreementLine[]
  invoiceLines    SalesInvoiceLine[]
  agentPlacements AgentStockPlacement[]
}

// Storage topology: single dry pool + conditioning tanks + FG warehouses
enum StorageKind {
  DRY_POOL
  CONDITIONING_TANK
  FG_WAREHOUSE
}

model StorageLocation {
  id        String      @id @default(cuid())
  code      String      @unique // DRY_POOL, TANK_A, TANK_B, TANK_C, FG_WH_1...
  name      String
  kind      StorageKind
  capacityQ Decimal     @db.Decimal(12, 2) // quintals, editable without code change
  isActive  Boolean     @default(true)
}

// ─── Procurement (Module 2) ─────────────────────────────────────

enum IntakeStatus {
  PENDING_LAB
  FLAGGED
  ACCEPTED
  REJECTED
}

model WheatIntake {
  id             String        @id @default(cuid())
  intakeNo       String        @unique
  deliveryDate   DateTime
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  truckPlate     String
  wheatCategory  WheatCategory
  wheatOrigin    String?       // e.g. Ukraine / Russia for FOREIGN
  bagCount       Int           // 1 bag = 1 quintal; no weighbridge at intake
  quintals       Decimal       @db.Decimal(12, 2)
  // Weighbridge readings (kg)
  grossKg        Decimal?      @db.Decimal(12, 2)
  tareKg         Decimal?      @db.Decimal(12, 2)
  netKg          Decimal?      @db.Decimal(12, 2)
  moistureQuick  Decimal?      @db.Decimal(5, 2) // quick gate moisture check
  // Purchase order linkage
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  // Lab gate — five parameters
  glutenPct      Decimal?      @db.Decimal(6, 2)
  moisturePct    Decimal?      @db.Decimal(6, 2)
  impurityPct    Decimal?      @db.Decimal(6, 2)
  hectoliterPct  Decimal?      @db.Decimal(6, 2)
  germinationPct Decimal?      @db.Decimal(6, 2)
  labTestedAt    DateTime?
  labTestedById  String?
  status         IntakeStatus  @default(PENDING_LAB)
  flaggedReasons String[]      @default([])
  // Executive override — explicit decision, never automatic
  decision       String?       // ACCEPT | REJECT | CONDITIONAL
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  returnNote     String?       // return-to-supplier instructions for rejections
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  unloadingLabor UnloadingLabor[]
  apInvoice      APInvoice?
  tankFills      TankFill[]
  batchSources   BatchIntakeSource[]
}

model UnloadingLabor {
  id         String      @id @default(cuid())
  intakeId   String
  intake     WheatIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  laborer    String      // name or crew identifier
  quintals   Decimal     @db.Decimal(12, 2)
  truckPlate String
  loggedAt   DateTime    @default(now())
  loggedById String?
}

model APInvoice {
  id          String      @id @default(cuid())
  invoiceNo   String      @unique
  intakeId    String      @unique
  intake      WheatIntake @relation(fields: [intakeId], references: [id])
  supplierId  String
  amountBirr  Decimal     @db.Decimal(18, 2)
  status      String      @default("OPEN") // OPEN | PARTIAL | PAID
  issuedAt    DateTime    @default(now())
  dueDate     DateTime?
  payments    APPayment[]
}

model APPayment {
  id           String      @id @default(cuid())
  voucherNo    String      @unique // auto Payment Voucher
  apInvoiceId  String
  apInvoice    APInvoice   @relation(fields: [apInvoiceId], references: [id])
  amountBirr   Decimal     @db.Decimal(18, 2)
  method       String      // BANK_TRANSFER | CHEQUE
  reference    String?
  paidAt       DateTime    @default(now())
  paidById     String?
}

// ─── Purchase Orders (Procurement) ─────────────────────────────────

enum POStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id                String        @id @default(cuid())
  poNo              String        @unique
  supplierId        String
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  wheatCategory     WheatCategory
  quantityQ         Decimal       @db.Decimal(12, 2)
  pricePerQBirr     Decimal       @db.Decimal(12, 2)
  totalBirr         Decimal       @db.Decimal(18, 2)
  deliveryDate      DateTime?
  terms             String?
  status            POStatus      @default(DRAFT)
  receivedQ         Decimal       @db.Decimal(12, 2) @default(0)
  approvedById      String?
  approvedAt        DateTime?
  cancelledById     String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  intakes           WheatIntake[]
}

// ─── Storage & Conditioning (Module 3) ──────────────────────────

model StorageMovement {
  id           String          @id @default(cuid())
  locationCode String          // DRY_POOL etc.
  direction    String          // IN | OUT | ADJUST
  quintals     Decimal         @db.Decimal(12, 2)
  wheatType    String?         // SOFT | HARD | FOREIGN
  reference    String?         // intakeNo / wash batch
  notes        String?
  movedAt      DateTime        @default(now())
  movedById    String?
}

model ConditioningCycle {
  id            String    @id @default(cuid())
  tankCode      String    // TANK_A | TANK_B | TANK_C
  batchNo       String    @unique // PB-2026-0001
  blendRatio    Json?     // { soft: 40, hard: 60, foreign: 0 }
  startedAt     DateTime  @default(now())
  requiredHrs   Decimal   @db.Decimal(6, 2) // required conditioning duration
  waterAddedQ   Decimal?  @db.Decimal(12, 2) // quintals of water added
  moistureBefore Decimal? @db.Decimal(5, 2) // % before conditioning
  moistureAfter  Decimal? @db.Decimal(5, 2) // % after conditioning (target 15.0-16.5)
  completedAt   DateTime?
  completedById String?
  releasedAt    DateTime?
  releasedById  String?
  notes         String?
}

model TankFill {
  id           String          @id @default(cuid())
  tankCode     String          // TANK_A | TANK_B | TANK_C
  intakeId     String?
  intake       WheatIntake?    @relation(fields: [intakeId], references: [id])
  quintals     Decimal         @db.Decimal(12, 2)
  blendRatio   Json?           // { soft: 40, hard: 60, foreign: 0 }
  filledAt     DateTime        @default(now())
  filledById   String?
}

model TankEvent {
  id         String   @id @default(cuid())
  tankCode   String
  event      String   // PARTIAL_EMPTY | EMPTIED | MARKED_READY
  quintals   Decimal? @db.Decimal(12, 2)
  note       String?
  occurredAt DateTime @default(now())
  byId       String?
}

model WashingLog {
  id              String   @id @default(cuid())
  tankOrSilo      String
  startedAt       DateTime
  endedAt         DateTime?
  durationMin     Int?
  downtimeMin     Int?     @default(0)
  equipmentChange String?
  operators       String[] @default([])
  batchId         String?
  batch           ProductionBatch? @relation(fields: [batchId], references: [id])
  createdById     String?
  waterUsedL      Int?
  impurityBeforePct Decimal? @db.Decimal(5, 2)
  impurityAfterPct  Decimal? @db.Decimal(5, 2)
}

// ─── Production & Blending (Module 4) ───────────────────────────

enum BatchProductType {
  HARD_FLOUR
  SOFT_FLOUR
}

model ProductionBatch {
  id            String           @id @default(cuid())
  batchNo       String           @unique
  productType   BatchProductType
  // Per-batch blend, set fresh by lab and locked permanently
  blendSoftPct  Decimal          @db.Decimal(5, 2)
  blendHardPct  Decimal          @db.Decimal(5, 2)
  blendForeignPct Decimal        @db.Decimal(5, 2)
  blendSoftQ    Decimal          @db.Decimal(12, 2)
  blendHardQ    Decimal          @db.Decimal(12, 2)
  blendForeignQ Decimal          @db.Decimal(12, 2)
  wheatWeighedQ Decimal          @db.Decimal(12, 2)
  status        String           @default("OPEN") // OPEN | MILLING | QC_HOLD | APPROVED | CLOSED
  createdAt     DateTime         @default(now())
  createdById   String?
  sources       BatchIntakeSource[]
  shifts        ShiftRun[]
  labChecks     LabCheck[]
  capas         CAPA[]
  packRuns      PackagingRun[]
  washing       WashingLog[]
  plans         ProductionPlan[]
  millingRuns   MillingRun[]
  flourOutputs  FlourOutput[]
  flourTests    FlourQualityTest[]
  nonconformities Nonconformity[]
}

// Which intake deliveries fed a batch (lot continuity)
model BatchIntakeSource {
  batchId  String
  batch    ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  intakeId String
  intake   WheatIntake     @relation(fields: [intakeId], references: [id])
  quintals Decimal         @db.Decimal(12, 2)

  @@id([batchId, intakeId])
}

enum ShiftType {
  MORNING
  NIGHT
}

model ShiftRun {
  id          String    @id @default(cuid())
  batchId     String
  batch       ProductionBatch @relation(fields: [batchId], references: [id])
  shift       ShiftType
  shiftDate   DateTime  @db.Date
  startedAt   DateTime
  endedAt     DateTime?
  operators   String[]  @default([])
  downtimeMin Int?      @default(0)
  downtimeReason String?
  outputs     ShiftOutput[]
  labChecks   LabCheck[]
  createdById String?
  handovers   ShiftHandover[]
}

model ShiftOutput {
  id          String   @id @default(cuid())
  shiftRunId  String
  shiftRun    ShiftRun @relation(fields: [shiftRunId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quintals    Decimal  @db.Decimal(12, 2)
  // Extraction snapshot: Duket quintals / total quintals * 100 for the shift
  extractionPct Decimal? @db.Decimal(6, 2)
  belowYieldFlag Boolean @default(false)
  loggedAt    DateTime @default(now())
  loggedById  String?
}

// ─── Quality Control (Module 5) ─────────────────────────────────

model QcThreshold {
  id        String  @id @default(cuid())
  code      String  @unique // e.g. "intake.gluten.min", "flour.moisture.max"
  category  String  // intake | inprocess
  param     String
  minValue  Decimal? @db.Decimal(8, 3)
  maxValue  Decimal? @db.Decimal(8, 3)
  unit      String?
  isActive  Boolean @default(true)
}

model LabCheck {
  id                 String          @id @default(cuid())
  shiftRunId         String
  shiftRun           ShiftRun        @relation(fields: [shiftRunId], references: [id], onDelete: Cascade)
  batchId            String
  batch              ProductionBatch @relation(fields: [batchId], references: [id])
  sampleTime         DateTime
  impurityPct        Decimal? @db.Decimal(6, 2)
  wheatMoistureBefore Decimal? @db.Decimal(6, 2)
  wheatMoistureAfter  Decimal? @db.Decimal(6, 2)
  flourMoisturePct   Decimal? @db.Decimal(6, 2)
  wetGlutenPct       Decimal? @db.Decimal(6, 2)
  glutenElasticity   String?  // strong | medium
  dryGlutenPct       Decimal? @db.Decimal(6, 2)
  ashPct             Decimal? @db.Decimal(6, 2)
  colorScore         Decimal? @db.Decimal(6, 2)
  granulationPct     Decimal? @db.Decimal(6, 2)
  outOfRange         String[] @default([])
  checkedById        String?
  createdAt          DateTime @default(now())
}

// ─── CAPA (Module 6) ────────────────────────────────────────────

enum CAPAStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum Disposition {
  BLENDED_ELSEWHERE
  FULLY_RECYCLED
}

model CAPA {
  id               String       @id @default(cuid())
  capaNo           String       @unique
  batchId          String
  batch            ProductionBatch @relation(fields: [batchId], references: [id])
  dateIdentified   DateTime     @default(now())
  issueDescription String
  identifiedById   String?
  correctionType   String?
  correctionDetail String?
  performedBy      String?
  disposition      Disposition?
  qualitySignById  String?
  qualitySignedAt  DateTime?
  productionSignById String?
  productionSignedAt DateTime?
  status           CAPAStatus   @default(OPEN)
  closedAt         DateTime?
  ncActions            NcAction[]
  linkedNonconformities Nonconformity[] @relation("NcLinkedCapa")
}

// ─── Hygiene (Module 7) & Pest (Module 8) ───────────────────────

enum CleaningGrade {
  NOT_PERFORMED
  NOT_SATISFACTORY
  SATISFACTORY
  GOOD
}

model EquipmentCleaning {
  id            String         @id @default(cuid())
  checkMonth    DateTime       @db.Date
  section       String         // pre-cleaning | cleaning | milling
  equipment     String
  grade         CleaningGrade
  nonconformity String?
  actionTaken   String?
  checkedById   String?
}

model DailyCleaningReport {
  id             String   @id @default(cuid())
  reportDate     DateTime @db.Date
  area           String   // office | changing room | production room | ...
  dryCleaned     Boolean  @default(false)
  wetCleaned     Boolean  @default(false)
  janitor        String?
  overallStatus  String?
  supervisorSign String?
  qualitySign    String?
  createdById    String?

  @@unique([reportDate, area])
}

model PestInspection {
  id             String   @id @default(cuid())
  area           String   // wheat store | dumping area | pre-cleaning | production room | cleaning section
  inspectedAt    DateTime @default(now())
  signsObserved  String?
  evidenceFound  String?
  correctiveAction String? // e.g. fumigation with insecticide
  followUpDate   DateTime?
  followUpDone   Boolean  @default(false)
  inspectorId    String?
}

// ─── Maintenance (Module 9) ─────────────────────────────────────

model MaintenanceLog {
  id             String   @id @default(cuid())
  equipment      String
  inspectionDate DateTime @db.Date
  inspector      String?
  outcome        String?
  followUpAction String?
  partReplaced   String?
  signOffById    String?
  isOverdue      Boolean  @default(false)
}

model SparePartCheck {
  id          String   @id @default(cuid())
  partName    String
  equipment   String?
  checkType   String   // STOCK_LEVEL | PHYSICAL_CONDITION (configurable)
  condition   String?
  checkedAt   DateTime @default(now())
  checkedById String?
}

// ─── Finished Goods & Warehouse (Modules 10–11) ─────────────────

model PackagingRun {
  id              String         @id @default(cuid())
  batchId         String
  batch           ProductionBatch @relation(fields: [batchId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  packagingSizeId String
  bags            Int
  quintals        Decimal        @db.Decimal(12, 2)
  productionDate  DateTime       @db.Date
  packedAt        DateTime       @default(now())
  packedById      String?
  line       String?
  operator   String?
  startedAt  DateTime?
  endedAt    DateTime?
}

model FinishedGoodsStock {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  batchNo         String
  packagingSizeId String?
  locationCode    String   // FG warehouse code
  bags            Int      @default(0)
  quintals        Decimal  @db.Decimal(12, 2)
  receivedAt      DateTime @default(now())

  @@unique([productId, batchNo, packagingSizeId, locationCode])
}

model WarehouseTransfer {
  id           String   @id @default(cuid())
  productId    String
  batchNo      String
  fromLocation String
  toLocation   String
  quintals     Decimal  @db.Decimal(12, 2)
  laborer      String?
  movedAt      DateTime @default(now())
  movedById    String?
}

// ─── Sales & Distribution (Module 13) ───────────────────────────

model SalesOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  orderDate     DateTime @default(now())
  requestedDate DateTime?
  productId     String
  quintals      Decimal  @db.Decimal(12, 2)
  priceBirr     Decimal  @db.Decimal(18, 2) // customer-specific price (legacy single-line)
  status        String   @default("OPEN") // DRAFT|CONFIRMED|PROCESSING|LOADING|DISPATCHED|DELIVERED|CANCELLED (+legacy OPEN|LOADED|INVOICED|CLOSED)
  createdById   String?
  dispatchLines DispatchLine[]
  lines         SalesOrderLine[]
  loadItems     TruckLoadItem[]
}

model AdvancePayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amountBirr       Decimal  @db.Decimal(18, 2)
  appliedAmountBirr Decimal @db.Decimal(18, 2) @default(0)
  status           String   @default("OPEN") // OPEN | PARTIAL | APPLIED
  paidAt           DateTime @default(now())
  receivedById     String?
  applications     AdvanceApplication[]
}

model Vehicle {
  id               String   @id @default(cuid())
  plateNo          String   @unique
  vehicleType      String? // TRUCK | PICKUP
  capacityQt       Decimal? @db.Decimal(12, 2)
  ownership        String   // OWNED | RENTED
  status           String   @default("AVAILABLE") // AVAILABLE | ON_TRIP | IN_MAINTENANCE | OFF_DUTY
  purchaseDate     DateTime? @db.Date
  purchaseCostBirr Decimal? @db.Decimal(18, 2)
  notes            String?
  isActive         Boolean  @default(true)
  trips            Trip[]
  dispatches       Dispatch[]
  contracts        VehicleContract[]
  driverAssignments DriverAssignment[]
  fleetTrips       FleetTrip[]
  fuelLogs         FuelLog[]
  expenses         FleetExpense[]
  maintenanceRecords FleetMaintenanceRecord[]
  truckLoads       TruckLoad[]
  deliveryTrips    DeliveryTrip[]
}

// Rental contracts for rented vehicles + depreciation records for owned ones.
model VehicleContract {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  vendor       String   // rental vendor name; "SELF" for owned-vehicle depreciation record
  contractType String   // RENTAL_DAILY | RENTAL_MONTHLY | OWNED
  rateBirr     Decimal  @db.Decimal(18, 2) // per day / per month / per year (owned depreciation)
  startDate    DateTime @db.Date
  endDate      DateTime? @db.Date
  terms        String?
  status       String   @default("ACTIVE") // ACTIVE | EXPIRED | TERMINATED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

// Driver ↔ vehicle assignments with license validity tracking.
model DriverAssignment {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  driverName    String
  licenseNo     String?
  licenseExpiry DateTime? @db.Date
  assignedFrom  DateTime @db.Date
  assignedTo    DateTime? @db.Date // null = currently assigned
  status        String   @default("ACTIVE") // ACTIVE | ENDED
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

// Detailed trip log (delivery + procurement). The existing Trip model stays for
// payroll fixed-trip-rate accounting; FleetTrip links to sales Dispatch where applicable.
model FleetTrip {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  driverName    String?
  routeFrom     String?
  routeTo       String?
  cargoType     String? // FLOUR | WHEAT | BRAN | OTHER
  cargoQt       Decimal? @db.Decimal(12, 2)
  departureAt   DateTime?
  arrivalAt     DateTime?
  odometerStart Decimal? @db.Decimal(12, 2)
  odometerEnd   Decimal? @db.Decimal(12, 2)
  status        String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  dispatchId    String?  // link to sales Dispatch (no FK to keep modules loosely coupled)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([departureAt])
}

// Fuel refills per vehicle → km/L efficiency derived from consecutive odometer readings.
model FuelLog {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  loggedAt    DateTime @default(now())
  liters      Decimal  @db.Decimal(12, 2)
  costBirr    Decimal  @db.Decimal(18, 2)
  odometer    Decimal? @db.Decimal(12, 2)
  station     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([loggedAt])
}

// Non-fuel operating expenses (tolls, insurance, washing, repairs consumables, ...).
model FleetExpense {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  expenseDate DateTime @db.Date
  category    String   // TOLL | REPAIR_PARTS | INSURANCE | WASHING | OTHER
  amountBirr  Decimal  @db.Decimal(18, 2)
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([expenseDate])
}

// Vehicle-level service history. Equipment-level maintenance stays in the
// Maintenance module; FleetMaintenanceRecord may reference it in description.
model FleetMaintenanceRecord {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceType String   // PREVENTIVE | CORRECTIVE | INSPECTION
  description String
  serviceDate DateTime @db.Date
  costBirr    Decimal  @db.Decimal(18, 2) @default(0)
  odometer    Decimal? @db.Decimal(12, 2)
  nextDueDate DateTime? @db.Date
  performedBy String?
  status      String   @default("COMPLETED") // SCHEDULED | COMPLETED
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([nextDueDate])
}

// Fixed trip rule: one trip per vehicle + destination area + departure,
// regardless of stop count or quantity.
model Trip {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  driverName    String?
  area          String   // destination area
  departureDate DateTime @db.Date
  stops         Int      @default(1)
  totalQuintals Decimal  @db.Decimal(12, 2)
  tripPayBirr   Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  @@unique([vehicleId, area, departureDate])
}

model Dispatch {
  id            String   @id @default(cuid())
  exitNoteNo    String   @unique
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  area          String
  dispatchedAt  DateTime @default(now())
  loadingLabor  String?  // piece-rate crew reference
  tripId        String?
  status        String   @default("DISPATCHED") // DISPATCHED | IN_TRANSIT | DELIVERED
  createdById   String?
  lines         DispatchLine[]
  invoice       SalesInvoice?
  // Gate-pass workflow (exit gate for outgoing trucks)
  gateStatus    String    @default("PENDING") // PENDING | AT_GATE | EXITED
  gateCheckedAt DateTime?
  sealNo        String?
  gateOfficer   String?
  gateNotes     String?
  deliveryTrips DeliveryTrip[]
}

model DispatchLine {
  id              String     @id @default(cuid())
  dispatchId      String
  dispatch        Dispatch   @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  orderId         String?
  order           SalesOrder? @relation(fields: [orderId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  batchNo         String?
  packagingSizeId String?
  bags            Int        @default(0)
  quintals        Decimal    @db.Decimal(12, 2)
}

enum RevenueStatus {
  PLACEMENT   // in-transit with agent, not yet revenue
  INVOICED    // formal receipt/invoice cut — recognized revenue
  PAID
}

model SalesInvoice {
  id            String        @id @default(cuid())
  invoiceNo     String        @unique
  dispatchId    String?       @unique
  dispatch      Dispatch?     @relation(fields: [dispatchId], references: [id])
  customerId    String
  amountBirr    Decimal       @db.Decimal(18, 2)
  status        RevenueStatus @default(PLACEMENT)
  invoicedAt    DateTime?
  createdAt     DateTime      @default(now())
  receipts      CashReceipt[]
  source        String        @default("DISPATCH") // DISPATCH | ORDER
  orderIds      String[]      @default([])
  lines         SalesInvoiceLine[]
  applications  AdvanceApplication[]
}

model CashReceipt {
  id          String   @id @default(cuid())
  receiptNo   String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  invoiceId   String?
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  amountBirr  Decimal   @db.Decimal(18, 2)
  // "The company" as ledger node for indirect settlements
  settledVia  String?   // e.g. "COMPANY" when customer pays a vendor on company's behalf
  receivedAt  DateTime  @default(now())
  receivedById String?
}

// ─── Finance — Peachtree GL (Module 14) ─────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id        String      @id @default(cuid())
  code      String      @unique // Peachtree-style codes
  name      String
  type      AccountType
  parentId  String?
  isActive  Boolean     @default(true)
  lines     JournalLine[]
}

model JournalEntry {
  id            String   @id @default(cuid())
  entryNo       String   @unique
  entryDate     DateTime @db.Date
  memo          String?
  module        String   // procurement | sales | payroll | general
  referenceType String?  // WheatIntake | APPayment | SalesInvoice | ...
  referenceId   String?
  createdById   String?
  createdAt     DateTime @default(now())
  lines         JournalLine[]
}

model JournalLine {
  id        String         @id @default(cuid())
  entryId   String
  entry     JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   ChartOfAccount @relation(fields: [accountId], references: [id])
  debit     Decimal        @db.Decimal(18, 2) @default(0)
  credit    Decimal        @db.Decimal(18, 2) @default(0)
  memo      String?
}

// ─── Finance expansion — Module 14 (vouchers, expenses, cash & bank) ──

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum VoucherKind {
  PAYMENT
  RECEIPT
}

enum VoucherStatus {
  DRAFT
  APPROVED
  POSTED
  CANCELLED
}

enum CashAccountKind {
  CASH
  BANK
}

model ExpenseCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  glAccountCode String?  // default expense GL account to debit
  isActive      Boolean  @default(true)
  claims        ExpenseClaim[]
}

model ExpenseClaim {
  id            String      @id @default(cuid())
  claimNo       String      @unique
  title         String
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  amountBirr    Decimal     @db.Decimal(18, 2)
  glAccountCode String      // expense GL account to debit on posting
  status        ClaimStatus @default(DRAFT)
  notes         String?
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  journalId     String?     // posted GL JournalEntry id (via referenceType/ReferenceId lookup)
  createdAt     DateTime    @default(now())
}

model CashBankAccount {
  id            String          @id @default(cuid())
  name          String
  kind          CashAccountKind
  bankName      String?
  accountNo     String?
  glAccountCode String          // linked chart of accounts code (ASSET), balances derive from GL
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  vouchers      FinanceVoucher[]
  transfersFrom CashTransfer[]  @relation("transferFrom")
  transfersTo   CashTransfer[]  @relation("transferTo")
}

model CashTransfer {
  id            String   @id @default(cuid())
  transferNo    String   @unique
  fromAccountId String
  fromAccount   CashBankAccount @relation("transferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     CashBankAccount @relation("transferTo", fields: [toAccountId], references: [id])
  amountBirr    Decimal  @db.Decimal(18, 2)
  transferDate  DateTime @db.Date @default(now())
  memo          String?
  createdById   String?
  createdAt     DateTime @default(now())
}

model FinanceVoucher {
  id                String        @id @default(cuid())
  voucherNo         String        @unique
  kind              VoucherKind
  counterparty      String        // payee (payment) or payer (receipt)
  amountBirr        Decimal       @db.Decimal(18, 2)
  method            String        // CASH | BANK_TRANSFER | CHEQUE
  reference         String?       // cheque no / transfer ref
  cashBankAccountId String?
  cashBankAccount   CashBankAccount? @relation(fields: [cashBankAccountId], references: [id])
  debitAccountCode  String        // GL account to debit
  creditAccountCode String        // GL account to credit
  memo              String?
  status            VoucherStatus @default(DRAFT)
  approvedById      String?
  approvedAt        DateTime?
  postedAt          DateTime?
  createdById       String?
  createdAt         DateTime      @default(now())
}

// ─── HR & Payroll (Module 15) ────────────────────────────────────

enum PayrollMode {
  FIXED
  PIECE_RATE
  TRIP_BASED
}

model Employee {
  id           String      @id @default(cuid())
  employeeNo   String      @unique
  name         String
  phone        String?
  jobTitle     String      // lab technician | machine operator | floor laborer | driver | ...
  department   String?     // legacy free-text label; prefer departmentId
  departmentId String?
  departmentRef Department? @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id])
  payrollMode  PayrollMode @default(FIXED)
  baseSalary   Decimal?    @db.Decimal(18, 2)
  bankName     String?
  bankAccount  String?
  zkPin        String?     @unique // ZKTeco biometric PIN
  isActive     Boolean     @default(true)
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id])
  hiredAt      DateTime    @default(now())
  payrollLines PayrollLine[]
  attendance   AttendanceRecord[]
  pieceWork    PieceRateWork[]
  driverTripPays DriverTripPay[]
  allowances   EmployeeAllowance[]
  payslips     Payslip[]
}

enum PieceStage {
  UNLOADING
  GRANARY_DUMPING
  STORE_MOVEMENT
  TRUCK_LOADING
}

model PieceRateConfig {
  id            String     @id @default(cuid())
  stage         PieceStage @unique
  rateBirrPerQ  Decimal    @db.Decimal(12, 2)
  effectiveFrom DateTime   @default(now())
  isActive      Boolean    @default(true)
}

model PieceRateLog {
  id         String     @id @default(cuid())
  stage      PieceStage
  laborer    String
  quintals   Decimal    @db.Decimal(12, 2)
  truckPlate String?
  loggedAt   DateTime   @default(now())
  loggedById String?
}

model DriverTripRate {
  id           String   @id @default(cuid())
  rateBirrPerTrip Decimal @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  isActive     Boolean  @default(true)
}

model PayrollRun {
  id          String   @id @default(cuid())
  periodYear  Int
  periodMonth Int
  status      String   @default("DRAFT") // DRAFT | APPROVED | POSTED
  createdAt   DateTime @default(now())
  createdById String?
  reviewedById String?
  reviewedAt  DateTime?
  approvedById String?
  approvedAt  DateTime?
  postedAt    DateTime?
  journalEntryId String? // finance journal posted by the payroll integration
  lines       PayrollLine[]
  payslips    Payslip[]

  @@unique([periodYear, periodMonth])
}

model PayrollLine {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  mode          PayrollMode
  baseBirr      Decimal    @db.Decimal(18, 2) @default(0)
  overtimeHours Decimal    @db.Decimal(8, 2)  @default(0)
  overtimeBirr  Decimal    @db.Decimal(18, 2) @default(0)
  pieceQuintals Decimal    @db.Decimal(12, 2) @default(0)
  pieceBirr     Decimal    @db.Decimal(18, 2) @default(0)
  trips         Int        @default(0)
  tripBirr      Decimal    @db.Decimal(18, 2) @default(0)
  grossBirr     Decimal    @db.Decimal(18, 2)
  allowanceBirr Decimal    @db.Decimal(18, 2) @default(0)
  deductionBirr Decimal    @db.Decimal(18, 2) @default(0)
  netBirr       Decimal    @db.Decimal(18, 2) @default(0)
}

// ─── HR: departments & positions ────────────────────────────────

model Department {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  parentId    String?
  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children    Department[] @relation("DeptTree")
  description String?
  isActive    Boolean      @default(true)
  positions   Position[]
  employees   Employee[]
  teamChatChannels ChatChannel[]
}

model Position {
  id           String      @id @default(cuid())
  code         String      @unique
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  grade        String?
  bandMin      Decimal?    @db.Decimal(18, 2)
  bandMax      Decimal?    @db.Decimal(18, 2)
  isActive     Boolean     @default(true)
  employees    Employee[]
}

// ─── HR: attendance records (ZKTeco/manual/CSV) ─────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HALF_DAY
}

enum WorkSource {
  ZKTECO
  MANUAL
  CSV
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  date           DateTime         // normalized to midnight UTC
  status         AttendanceStatus @default(PRESENT)
  checkIn        DateTime?
  checkOut       DateTime?
  workHours      Decimal          @db.Decimal(6, 2) @default(0)
  overtimeHours  Decimal          @db.Decimal(6, 2) @default(0)
  lateMinutes    Int              @default(0)
  source         WorkSource       @default(MANUAL)
  notes          String?

  @@unique([employeeId, date])
  @@index([date])
}

// ─── HR: piece-rate work records (bags + quintals) ───────────────

model PieceRateWork {
  id            String     @id @default(cuid())
  employeeId    String?
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  laborer       String     // employee name or casual crew label
  stage         PieceStage
  bags          Int        @default(0)
  quintals      Decimal    @db.Decimal(12, 2)
  rateBirrPerQ  Decimal    @db.Decimal(12, 2)
  payBirr       Decimal    @db.Decimal(18, 2)
  workDate      DateTime   @default(now())
  truckPlate    String?
  loggedById    String?
  notes         String?

  @@index([employeeId, workDate])
  @@index([workDate])
}

// ─── HR: driver trip-based pay ───────────────────────────────────

model DriverTripPay {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  year            Int
  month           Int
  trips           Int      @default(0)
  rateBirrPerTrip Decimal  @db.Decimal(12, 2)
  allowanceBirr   Decimal  @db.Decimal(18, 2) @default(0)
  totalBirr       Decimal  @db.Decimal(18, 2)
  notes           String?
  createdById     String?

  @@unique([employeeId, year, month])
}

// ─── HR: allowances & deductions ─────────────────────────────────

enum AllowanceKind {
  ALLOWANCE
  DEDUCTION
}

enum AllowanceCalc {
  FIXED
  PERCENT
}

enum AllowanceRecurrence {
  RECURRING
  ONE_TIME
}

model AllowanceDeductionType {
  id         String               @id @default(cuid())
  code       String               @unique
  name       String
  kind       AllowanceKind
  calc       AllowanceCalc        @default(FIXED)
  amount     Decimal              @db.Decimal(18, 2)
  appliesTo  PayrollMode[]        // empty = all payroll modes
  recurrence AllowanceRecurrence  @default(RECURRING)
  isActive   Boolean              @default(true)
  assignments EmployeeAllowance[]
}

model EmployeeAllowance {
  id             String                  @id @default(cuid())
  employeeId     String
  employee       Employee                @relation(fields: [employeeId], references: [id])
  typeId         String
  type           AllowanceDeductionType  @relation(fields: [typeId], references: [id])
  oneTimeDate    DateTime?               // set for ONE_TIME assignments; null = recurring
  overrideAmount Decimal?                @db.Decimal(18, 2)
  isActive       Boolean                 @default(true)
  notes          String?

  @@unique([employeeId, typeId])
}

// ─── HR: payslips ────────────────────────────────────────────────

model Payslip {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  grossBirr     Decimal    @db.Decimal(18, 2)
  allowanceBirr Decimal    @db.Decimal(18, 2) @default(0)
  deductionBirr Decimal    @db.Decimal(18, 2) @default(0)
  netBirr       Decimal    @db.Decimal(18, 2)
  breakdown     Json       @default("{}")
  generatedAt   DateTime   @default(now())

  @@unique([payrollRunId, employeeId])
}

// ─── ZKTeco attendance ──────────────────────────────────────────

model ZKTecoDevice {
  id        String   @id @default(cuid())
  serialNo  String   @unique // SN from ADMS handshake
  name      String?
  location  String?
  ipAddress String?
  lastSeen  DateTime?
  isActive  Boolean  @default(true)
}

enum PunchStatus {
  CHECK_IN
  CHECK_OUT
}

model AttendancePunch {
  id         String      @id @default(cuid())
  zkPin      String
  employeeId String?
  punchTime  DateTime
  status     PunchStatus
  verifyMode String?     // Fingerprint | Face | Card | Password
  workCode   String?
  deviceSn   String?
  syncedAt   DateTime    @default(now())

  @@unique([zkPin, punchTime, deviceSn])
  @@index([zkPin, punchTime])
}

// ─── SMS (AfroMessage) ──────────────────────────────────────────

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
}

model SmsLog {
  id         String    @id @default(cuid())
  to         String
  message    String
  trigger    String?   // e.g. INTAKE_FLAGGED, LOW_YIELD, LAB_OVERDUE
  status     SmsStatus @default(QUEUED)
  attempts   Int       @default(0)
  providerId String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ─── Offline sync & audit ───────────────────────────────────────

model IdempotencyLedger {
  clientUuid  String   @id // UUIDv7 from the device
  entityType  String
  entityId    String?
  deviceId    String?
  receivedAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // CREATE | UPDATE | APPROVE | REJECT | SYNC | ...
  entityType String
  entityId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ─── Module 19: Module Manager (Feature Toggles) ────────────────────
model ModuleToggle {
  id          String   @id @default(cuid())
  moduleKey   String   @unique // e.g. 'procurement', 'fleet', 'maintenance'
  name        String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Module 20: API Management & Monitoring ─────────────────────────
model ApiIntegration {
  id            String   @id @default(cuid())
  name          String   // 'AfroMessage SMS', 'ZKTeco ADMS'
  type          String   // 'sms' | 'biometric' | 'webhook' | 'custom'
  baseUrl       String?
  status        String   @default("unknown") // 'online' | 'offline' | 'degraded' | 'unknown'
  lastCheckedAt DateTime?
  latencyMs     Int?
  uptimePct     Float?   // rolling uptime percentage
  config        Json?    // non-secret config: rate limits, webhook settings
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  healthLogs    ApiHealthLog[]
}

model ApiHealthLog {
  id            String         @id @default(cuid())
  integrationId String
  integration   ApiIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        String         // 'online' | 'offline' | 'degraded'
  latencyMs     Int?
  message       String?
  createdAt     DateTime       @default(now())

  @@index([integrationId, createdAt])
}

// ─── Module 21: Support & Documentation ─────────────────────────────
model SupportTicket {
  id          String   @id @default(cuid())
  ticketNo    String   @unique
  title       String
  description String
  category    String   // 'technical' | 'hardware' | 'operational'
  priority    String   @default("medium") // 'low' | 'medium' | 'high' | 'urgent'
  status      String   @default("open")   // 'open' | 'in_progress' | 'resolved' | 'closed'
  reporterId  String
  reporter    User     @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments    TicketComment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, priority])
}

model TicketComment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}

model DocArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   // markdown SOP content
  module    String?  // ERP module key this doc belongs to
  role      String?  // role name filter, null = all roles
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// Module 4 — merged 2026-10-17
// ═══════════════════════════════════════════════════════════════════
// Also add the listed relation fields to the existing models (ProductionBatch,
// ShiftRun) and the extra columns to WashingLog (see migration-module4.sql).
// Do NOT duplicate anything already defined elsewhere.

model BlendRecipe {
  id          String   @id @default(cuid())
  name        String
  // DUKET_NORMAL | DUKET_SPECIAL | FURISHKA | FINO | FERNACHO
  productType String
  hardPct     Decimal  @db.Decimal(5, 2)
  softPct     Decimal  @db.Decimal(5, 2)
  foreignPct  Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(false)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionPlan {
  id            String          @id @default(cuid())
  planNo        String          @unique
  // Released conditioning tank chosen for this plan (optional, informational)
  tankCode      String?
  batchId       String?
  batch         ProductionBatch? @relation(fields: [batchId], references: [id])
  // JSON: [{ "productType": "DUKET_NORMAL", "plannedQ": 120 }]
  targets       Json
  plannedWheatQ Decimal         @db.Decimal(12, 2)
  scheduledDate DateTime        @db.Date
  // MORNING | NIGHT
  shift         String
  // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  status        String          @default("PLANNED")
  actualWheatQ  Decimal?        @db.Decimal(12, 2)
