// ─── Module 18: System Administration ─────────────────────────────
// Added by admin module worker 2026-10-17. Keep namespaced — do not
// rename existing models above.

/// Generic key/value system settings (preferences, security policy,
/// notification & SMS configuration, backup schedule). Keys are
/// dot-namespaced, e.g. "prefs.timezone", "security.sessionTimeoutMin".
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Outbound webhook endpoint configuration (Module 18).
model Webhook {
  id         String            @id @default(cuid())
  name       String
  url        String
  events     Json              // string[] of event codes, e.g. ["intake.created", "qc.failed"]
  secret     String?
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
}

/// Delivery attempt log for outbound webhooks (Module 18).
model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  payload    Json
  status     String   // "delivered" | "failed"
  attempts   Int      @default(1)
  httpStatus Int?
  responseBody String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([webhookId, createdAt])
}

