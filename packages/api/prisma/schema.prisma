// ─── MERGE INTO EXISTING: model Product — add these back-relations ─────────
//   grades       FlourGrade[]
//   labelPrints  LabelPrint[]
//   fgAdjustments FgStockAdjustment[]

// ─── New models ────────────────────────────────────────────────────────────

model FlourGrade {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  gradeCode     String   // e.g. DUKET-N, DUKET-S, FURISHKA, FINO, FERNACHO
  name          String
  moistureMax   Decimal  @db.Decimal(5, 2) @default(14.0) // flour moisture ≤14.0%
  wetGlutenMin  Decimal  @db.Decimal(5, 2) @default(30.0) // wet gluten 30–33%
  wetGlutenMax  Decimal  @db.Decimal(5, 2) @default(33.0)
  ashMax        Decimal  @db.Decimal(5, 2) @default(0.7)  // ash ≤0.7%
  shelfLifeDays Int      @default(180)
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, gradeCode])
}

model LabelPrint {
  id              String   @id @default(cuid())
  packagingRunId  String?
  batchNo         String
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  packagingSizeId String?
  bagKg           Decimal  @db.Decimal(6, 2)
  copies          Int      @default(1)
  productionDate  DateTime @db.Date
  expiryDate      DateTime @db.Date
  status          String   @default("PRINTED") // PRINTED | REPRINTED
  reprintReason   String?
  printedAt       DateTime @default(now())
  printedById     String?

  @@index([batchNo])
  @@index([productId])
}

model ByproductStock {
  id           String   @id @default(cuid())
  type         String   // BRAN | SHORTS
  batchNo      String?
  locationCode String   @default("BP_WH_1")
  quintals     Decimal  @db.Decimal(12, 2)
  receivedAt   DateTime @default(now())

  @@unique([type, batchNo, locationCode])
}

model ByproductMovement {
  id         String   @id @default(cuid())
  type       String   // BRAN | SHORTS
  direction  String   // IN | OUT
  quintals   Decimal  @db.Decimal(12, 2)
  reference  String?  // e.g. batch no / sales order / disposal note
  reason     String?
  movedAt    DateTime @default(now())
  movedById  String?

  @@index([type, movedAt])
}

model FgStockAdjustment {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  batchNo         String
  packagingSizeId String?
  locationCode    String
  bagsDelta       Int      @default(0)
  quintalsDelta   Decimal  @db.Decimal(12, 2)
  reason          String
  status          String   @default("DRAFT") // DRAFT | APPROVED | REJECTED
  createdById     String?
  approvedById    String?
  createdAt       DateTime @default(now())

  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// Module 11 — merged 2026-10-17
// ═══════════════════════════════════════════════════════════════════
//  1. Append this block to schema.prisma (suggested location: after the
//     FG-warehouse / WarehouseTransfer section, before Sales & Distribution).
//  2. Append the back-reference fields listed under "BACK-REFERENCES" to the
//     existing model Product.
//  3. Run: npx prisma migrate dev --name module11-warehouse ; npx prisma generate


enum WhLocationType {
  RAW
  FG
  SPARE
  GENERAL
}

enum WhMovementType {
  RECEIVE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUST_IN
  ADJUST_OUT
  ISSUE
  DISPATCH
  COUNT_IN
  COUNT_OUT
}

enum WhPutAwayStatus {
  DRAFT
  PLACED
  CANCELLED
}

enum WhTransferStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum WhAdjustReason {
  DAMAGE
  FOUND
  RECOUNT
  SPOILAGE
  OTHER
}

enum WhAdjustStatus {
  PENDING
  APPROVED
  POSTED
  REJECTED
}

enum WhReserveStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

enum WhDispatchStatus {
  DRAFT
  PICKED
  DISPATCHED
  CANCELLED
}

enum WhCountStatus {
  PLANNED
  IN_PROGRESS
  RECOUNT
  APPROVED
  POSTED
  CANCELLED
}


model WhLocation {
  id        String         @id @default(cuid())
  code      String         @unique // e.g. WH-RM-A1, WH-FG-01
  name      String
  zone      String?
  type      WhLocationType @default(GENERAL)
  capacityQ Decimal        @db.Decimal(12, 2) @default(0) // quintals
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  ledger          WhStockLedger[]
  suggestedItems  WhPutAwayItem[]     @relation("PutAwaySuggested")
  placedItems     WhPutAwayItem[]     @relation("PutAwayPlaced")
  transferSources WhStockTransfer[]   @relation("TransferFrom")
  transferDests   WhStockTransfer[]   @relation("TransferTo")
  adjustments     WhAdjustment[]
  reservations   WhReservation[]
  dispatchItems   WhDispatchItem[]
  countSessions   WhCountSession[]
}

model WhStockLedger {
  id           String         @id @default(cuid())
  locationId   String
  location     WhLocation     @relation(fields: [locationId], references: [id])
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  batchNo      String?
  quintals     Decimal        @db.Decimal(12, 2) // signed: +in / −out
  bags         Int            @default(0) // signed
  unitCostBirr Decimal?       @db.Decimal(14, 2) // cost on inbound lines
  movementType WhMovementType
  reference    String? // human doc no, e.g. WH-PA-0007
  refId        String? // owning module-11 record id
  movedAt      DateTime       @default(now())
  createdById  String?

  @@index([locationId, productId])
  @@index([movementType, movedAt])
  @@index([refId])
}

model WhPutAway {
  id           String          @id @default(cuid())
  docNo        String          @unique // WH-PA-0001
  referenceDoc String? // source document (PO / GRN / intake no)
  status       WhPutAwayStatus @default(DRAFT)
  receivedAt   DateTime        @default(now())
  createdById  String?
  items        WhPutAwayItem[]
}

model WhPutAwayItem {
  id          String    @id @default(cuid())
  putAwayId   String
  putAway     WhPutAway @relation(fields: [putAwayId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  batchNo     String?
  quintals    Decimal   @db.Decimal(12, 2)
  bags        Int       @default(0)
  packagingKg Int? // 50 | 25 | 10 | 5
  unitCostBirr Decimal? @db.Decimal(14, 2)

  suggestedLocationId String?
  suggestedLocation   WhLocation? @relation("PutAwaySuggested", fields: [suggestedLocationId], references: [id])
  placedLocationId    String?
  placedLocation      WhLocation? @relation("PutAwayPlaced", fields: [placedLocationId], references: [id])
  placedAt            DateTime?
}

model WhStockTransfer {
  id             String           @id @default(cuid())
  docNo          String           @unique // WH-TR-0001
  fromLocationId String
  fromLocation   WhLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     WhLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  reason         String?
  status         WhTransferStatus @default(REQUESTED)
  requestedById  String?
  approvedById   String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  items          WhStockTransferItem[]
}

model WhStockTransferItem {
  id         String          @id @default(cuid())
  transferId String
  transfer   WhStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  batchNo    String?
  quintals   Decimal         @db.Decimal(12, 2)
  bags       Int             @default(0)
}

model WhAdjustment {
  id          String         @id @default(cuid())
  docNo       String         @unique // WH-AD-0001
  locationId  String
  location    WhLocation     @relation(fields: [locationId], references: [id])
  status      WhAdjustStatus @default(PENDING)
  reason      String?
  createdById String?
  approvedById String?
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  items       WhAdjustmentItem[]
}

model WhAdjustmentItem {
  id           String         @id @default(cuid())
  adjustmentId String
  adjustment   WhAdjustment   @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  batchNo      String?
  quintals     Decimal        @db.Decimal(12, 2) // signed: +gain / −loss
  bags         Int            @default(0) // signed
  unitCostBirr Decimal?       @db.Decimal(14, 2)
  reason       WhAdjustReason
}

model WhReservation {
  id          String         @id @default(cuid())
  refNo       String         @unique // WH-RS-0001
  reference   String? // sales order / production order no
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  batchNo     String?
  locationId  String
  location    WhLocation     @relation(fields: [locationId], references: [id])
  quintals    Decimal        @db.Decimal(12, 2)
  bags        Int            @default(0)
  expiresAt   DateTime?
  status      WhReserveStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime       @default(now())
  releasedAt  DateTime?

  @@index([status, expiresAt])
}

model WhDispatch {
  id            String           @id @default(cuid())
  docNo         String           @unique // WH-DP-0001
  reference     String? // sales order no
  vehiclePlate  String?
  driverName    String?
  status        WhDispatchStatus @default(DRAFT)
  dispatchedAt  DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  items         WhDispatchItem[]
}

model WhDispatchItem {
  id         String     @id @default(cuid())
  dispatchId String
  dispatch   WhDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  batchNo    String?
  locationId String
  location   WhLocation @relation(fields: [locationId], references: [id])
  quintals   Decimal    @db.Decimal(12, 2)
  bags       Int        @default(0)
}

model WhCountSession {
  id            String       @id @default(cuid())
  sessionNo     String       @unique // WH-CT-0001
  locationId    String
  location      WhLocation   @relation(fields: [locationId], references: [id])
  scheduledDate DateTime
  status        WhCountStatus @default(PLANNED)
  createdById   String?
  approvedById  String?
  postedAt      DateTime?
  createdAt     DateTime     @default(now())
  lines         WhCountLine[]
}

model WhCountLine {
  id        String         @id @default(cuid())
  sessionId String
  session   WhCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  batchNo   String?
  systemQ   Decimal        @db.Decimal(12, 2) // snapshot at session creation
  systemBags Int           @default(0)
  countedQ  Decimal?       @db.Decimal(12, 2)
  countedBags Int?
  recountQ  Decimal?       @db.Decimal(12, 2)
  recountBags Int?
  varianceQ Decimal?       @db.Decimal(12, 2) // counted − system (posted)
}

//   whLedger        WhStockLedger[]
